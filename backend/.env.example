# Copia este fichero como .env y ajusta los valores
# cp .env.example .env

# Clave secreta para firmar los JWT de sesión — genera una con:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esta-clave-en-produccion

# URL de la base de datos (SQLite para desarrollo local)
DATABASE_URL=sqlite:///./puebloapp.db

# Directorio donde se guardan las imágenes subidas
IMAGES_DIR=media/imagenes

# Minutos de validez del token de sesión (86400 = 24h)
ACCESS_TOKEN_EXPIRE_MINUTES=1440
